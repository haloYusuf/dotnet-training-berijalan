@{
    ViewData["Title"] = "Login";
}

<div class="min-h-screen flex items-center justify-center -mt-16">
    <div class="w-full max-w-sm mx-4">
        @if (Context.Request.Query["registered"] == "1")
        {
            <div
                class="bg-emerald-50 border border-emerald-200 text-emerald-700 px-4 py-3 rounded-lg text-sm mb-6 text-center">
                Account created! Please sign in.</div>
            }

            <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8">
                <div class="text-center mb-8">
                    <div class="w-12 h-12 bg-indigo-100 rounded-xl flex items-center justify-center mx-auto mb-4">
                        <svg class="w-6 h-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                    </div>
                    <h1 class="text-xl font-bold text-gray-900">Welcome back</h1>
                    <p class="text-sm text-gray-500 mt-1">Sign in to your account</p>
                </div>

                <div id="formError" class="hidden bg-red-50 border border-red-200 rounded-lg p-3 mb-5">
                    <p class="text-sm text-red-700"></p>
                </div>

                <form onsubmit="handleLogin(event)" class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5" for="email">Email</label>
                        <input type="email" id="email" autocomplete="email" required
                               class="w-full px-3.5 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all"
                               placeholder="you@example.com">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5" for="password">Password</label>
                        <input type="password" id="password" autocomplete="current-password" required
                               class="w-full px-3.5 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all"
                               placeholder="Enter your password">
                    </div>
                    <button type="submit" id="submitBtn" data-original-text="Sign in"
                            class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2.5 px-4 rounded-lg text-sm transition-colors shadow-sm">
                        Sign in
                    </button>
                </form>

                <p class="text-center text-sm text-gray-500 mt-6">
                    Don't have an account? <a asp-action="Register"
                                              class="text-indigo-600 hover:text-indigo-700 font-medium">Create one</a>
                </p>
            </div>
        </div>
    </div>

    @section Scripts {
        <script src="~/js/auth.js" asp-append-version="true"></script>
    }
