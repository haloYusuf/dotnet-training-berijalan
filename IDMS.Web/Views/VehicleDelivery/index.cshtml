@{
    ViewData["Title"] = "Pengiriman Kendaraan";
}

<div class="mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
        <h1 class="text-2xl font-bold text-gray-900">Pengiriman Kendaraan</h1>
        <p class="text-sm text-gray-500 mt-1">Kelola data jadwal dan pelacakan pengiriman kendaraan.</p>
    </div>
    <button onclick="showAddModal()"
            class="inline-flex items-center justify-center rounded-md border border-transparent bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 sm:w-auto transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd"
                  d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z"
                  clip-rule="evenodd" />
        </svg>
        Tambah Jadwal Pengiriman
    </button>
</div>

<!-- Card Container -->
<div class="bg-white shadow-sm rounded-lg border border-gray-200 overflow-hidden">
    <!-- Header & Search -->
    <div class="p-4 border-b border-gray-200 bg-gray-50 flex flex-col sm:flex-row justify-between items-center gap-4">
        <h2 class="text-lg font-semibold text-gray-800">Daftar Pengiriman</h2>
        <div class="relative w-full sm:w-72">
            <input type="text" id="searchInput" placeholder="Cari driver / plat..."
                   class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-4 py-2 border">
            <button onclick="search()"
                    class="absolute inset-y-0 right-0 px-3 flex items-center bg-gray-100 border-l border-gray-300 rounded-r-md hover:bg-gray-200 text-gray-600">Cari</button>
        </div>
    </div>

    <!-- Table -->
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th scope="col"
                        class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Aplikasi
                        (ID)</th>
                        <th scope="col"
                            class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tgl Kirim
                        </th>
                        <th scope="col"
                            class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Driver /
                            Plat</th>
                            <th scope="col"
                                class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Dealer /
                                Asuransi</th>
                                <th scope="col"
                                    class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Status
                                </th>
                                <th scope="col"
                                    class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider w-48">
                                    Aksi</th>
                                </tr>
                            </thead>
                            <tbody id="delivTableBody" class="bg-white divide-y divide-gray-200">
                                <tr>
                                    <td colspan="6" class="px-6 py-8 text-center text-sm text-gray-500">Memuat data...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div id="paginationContainer" class="bg-gray-50 px-4 py-3 border-t border-gray-200 sm:px-6 hidden"></div>
                </div>

                <!-- Modal Form -->
                <div id="delivModal" class="relative z-50 hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
                    <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity"></div>
                    <div class="fixed inset-0 z-10 overflow-y-auto">
                        <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
                            <div
                                class="relative transform overflow-hidden rounded-lg bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-3xl">
                                <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                                    <h3 class="text-lg font-medium leading-6 text-gray-900 mb-4" id="delivModalLabel">Form Pengiriman
                                        Kendaraan</h3>
                                        <form id="delivForm">
                                            <input type="hidden" id="delivId">

                                            <div class="mb-4 flex flex-col sm:flex-row gap-4">
                                                <div class="w-full sm:w-1/3">
                                                    <label for="delivApplicationId" class="block text-sm font-medium text-gray-700">Aplikasi
                                                        / Transaksi <span class="text-red-500">*</span></label>
                                                        <select id="delivApplicationId" required
                                                                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm border px-3 py-2 bg-white">
                                                            <option value="">-- Pilih Aplikasi --</option>
                                                        </select>
                                                    </div>
                                                    <div class="w-full sm:w-1/3">
                                                        <label for="delivDealerId" class="block text-sm font-medium text-gray-700">Dealer
                                                            Pengirim <span class="text-red-500">*</span></label>
                                                            <select id="delivDealerId" required
                                                                    class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm border px-3 py-2 bg-white">
                                                                <option value="">-- Pilih Dealer --</option>
                                                            </select>
                                                        </div>
                                                        <div class="w-full sm:w-1/3">
                                                            <label for="delivInsuranceId" class="block text-sm font-medium text-gray-700">Asuransi
                                                                <span class="text-red-500">*</span></label>
                                                                <select id="delivInsuranceId" required
                                                                        class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm border px-3 py-2 bg-white">
                                                                    <option value="">-- Pilih Asuransi --</option>
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <div class="mb-4 flex flex-col sm:flex-row gap-4">
                                                            <div class="w-full sm:w-1/2">
                                                                <label for="delivDeliveryDate" class="block text-sm font-medium text-gray-700">Tanggal
                                                                    Pengiriman <span class="text-red-500">*</span></label>
                                                                    <!-- Memakai datetime-local karena fieldnya date-time -->
                                                                    <input type="date" id="delivDeliveryDate" required
                                                                           class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm border px-3 py-2">
                                                                </div>
                                                                <div class="w-full sm:w-1/2">
                                                                    <label for="delivStatus" class="block text-sm font-medium text-gray-700">Status <span
                                                                        class="text-red-500">*</span></label>
                                                                        <select id="delivStatus" required
                                                                                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm border px-3 py-2 bg-white">
                                                                            <option value="PLANNED">PLANNED</option>
                                                                            <option value="IN_TRANSIT">IN_TRANSIT</option>
                                                                            <option value="DELIVERED">DELIVERED</option>
                                                                            <option value="CANCELLED">CANCELLED</option>
                                                                        </select>
                                                                    </div>
                                                                </div>

                                                                <div class="mb-4 flex flex-col sm:flex-row gap-4">
                                                                    <div class="w-full sm:w-1/3">
                                                                        <label for="delivDriverName" class="block text-sm font-medium text-gray-700">Nama
                                                                            Supir/Kurir <span class="text-red-500">*</span></label>
                                                                            <input type="text" id="delivDriverName" required placeholder="Nama Supir"
                                                                                   class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm border px-3 py-2">
                                                                        </div>
                                                                        <div class="w-full sm:w-1/3">
                                                                            <label for="delivDriverPhone" class="block text-sm font-medium text-gray-700">No. HP
                                                                                Supir</label>
                                                                                <input type="text" id="delivDriverPhone" placeholder="081234..."
                                                                                       class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm border px-3 py-2">
                                                                            </div>
                                                                            <div class="w-full sm:w-1/3">
                                                                                <label for="delivPlatNumber" class="block text-sm font-medium text-gray-700">Plat
                                                                                    Kendaraan</label>
                                                                                    <input type="text" id="delivPlatNumber" placeholder="B 1234 XYZ"
                                                                                           class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm border px-3 py-2 uppercase">
                                                                                </div>
                                                                            </div>

                                                                            <div class="mb-4">
                                                                                <label for="delivNotes" class="block text-sm font-medium text-gray-700">Catatan</label>
                                                                                <textarea id="delivNotes" rows="2" placeholder="Catatan pengiriman..."
                                                                                          class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm border px-3 py-2"></textarea>
                                                                            </div>
                                                                        </form>
                                                                    </div>
                                                                    <div class="bg-gray-50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6">
                                                                        <button type="button" onclick="save()"
                                                                                class="inline-flex w-full justify-center rounded-md border border-transparent bg-indigo-600 px-4 py-2 text-base font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 sm:ml-3 sm:w-auto sm:text-sm">Simpan</button>
                                                                        <button type="button" onclick="hideModal()"
                                                                                class="mt-3 inline-flex w-full justify-center rounded-md border border-gray-300 bg-white px-4 py-2 text-base font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm">Batal</button>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    @section Scripts {
                                                        <script src="~/js/vehicleDelivery.js"></script>
                                                    }