@{
    ViewData["Title"] = "Master Model Kendaraan";
}

<div class="mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
        <h1 class="text-2xl font-bold text-gray-900">Master Model</h1>
        <p class="text-sm text-gray-500 mt-1">Kelola data model, harga, dan stok kendaraan beserta relasinya dengan
            tipe.</p>
        </div>
        <button onclick="modelController.showAddModal()"
                class="inline-flex items-center justify-center rounded-md border border-transparent bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 sm:w-auto transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd"
                      d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z"
                      clip-rule="evenodd" />
            </svg>
            Tambah Model Baru
        </button>
    </div>

    <!-- Card Container -->
    <div class="bg-white shadow-sm rounded-lg border border-gray-200 overflow-hidden">
        <!-- Header & Search -->
        <div class="p-4 border-b border-gray-200 bg-gray-50 flex flex-col sm:flex-row justify-between items-center gap-4">
            <h2 class="text-lg font-semibold text-gray-800">Daftar Model</h2>
            <div class="relative w-full sm:w-72">
                <input type="text" id="searchInput" placeholder="Cari kode/nama model..."
                       class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-4 py-2 border">
                <button onclick="modelController.search()"
                        class="absolute inset-y-0 right-0 px-3 flex items-center bg-gray-100 border-l border-gray-300 rounded-r-md hover:bg-gray-200 text-gray-600">
                    Cari
                </button>
            </div>
        </div>

        <!-- Table (Tanpa Kolom "No") -->
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th scope="col"
                            class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Kode</th>
                        <th scope="col"
                            class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Nama
                            Model</th>
                            <th scope="col"
                                class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tipe</th>
                            <th scope="col"
                                class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Tahun
                            </th>
                            <th scope="col"
                                class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Harga
                            </th>
                            <th scope="col"
                                class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Stok
                            </th>
                            <th scope="col"
                                class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Status
                            </th>
                            <th scope="col"
                                class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider w-48">
                                Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="modelTableBody" class="bg-white divide-y divide-gray-200">
                            <tr>
                                <td colspan="8" class="px-6 py-8 text-center text-sm text-gray-500">Memuat data...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Container Pagination -->
                <div id="paginationContainer" class="bg-gray-50 px-4 py-3 border-t border-gray-200 sm:px-6 hidden">
                    <!-- Elemen Paginasi dirender oleh JS -->
                </div>
            </div>

            <!-- Modal Form -->
            <div id="modelModal" class="relative z-50 hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
                <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity"></div>
                <div class="fixed inset-0 z-10 overflow-y-auto">
                    <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
                        <div
                            class="relative transform overflow-hidden rounded-lg bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-2xl">
                            <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                                <h3 class="text-lg font-medium leading-6 text-gray-900 mb-4" id="modelModalLabel">Form Model
                                    Kendaraan</h3>
                                    <form id="modelForm">
                                        <input type="hidden" id="modelId">

                                        <div class="mb-4">
                                            <label for="modelTypeId" class="block text-sm font-medium text-gray-700">Tipe Kendaraan
                                                <span class="text-red-500">*</span></label>
                                                <select id="modelTypeId" required
                                                        class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm border px-3 py-2 bg-white">
                                                    <option value="">-- Pilih Tipe --</option>
                                                    <!-- Option dirender oleh JS -->
                                                </select>
                                            </div>

                                            <div class="mb-4 flex gap-4">
                                                <div class="w-1/3">
                                                    <label for="modelCode" class="block text-sm font-medium text-gray-700">Kode <span
                                                        class="text-red-500">*</span></label>
                                                        <input type="text" id="modelCode" maxlength="20" required placeholder="Contoh: MDL01"
                                                               class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm border px-3 py-2 uppercase">
                                                    </div>
                                                    <div class="w-2/3">
                                                        <label for="modelName" class="block text-sm font-medium text-gray-700">Nama Model <span
                                                            class="text-red-500">*</span></label>
                                                            <input type="text" id="modelName" required placeholder="Contoh: CBR 250RR ABS"
                                                                   class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm border px-3 py-2">
                                                        </div>
                                                    </div>

                                                    <div class="mb-4 flex gap-4">
                                                        <div class="w-1/3">
                                                            <label for="modelYear" class="block text-sm font-medium text-gray-700">Tahun <span
                                                                class="text-red-500">*</span></label>
                                                                <input type="number" id="modelYear" min="1900" max="2099" required placeholder="2024"
                                                                       class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm border px-3 py-2">
                                                            </div>
                                                            <div class="w-1/3">
                                                                <label for="modelPrice" class="block text-sm font-medium text-gray-700">Harga (Rp) <span
                                                                    class="text-red-500">*</span></label>
                                                                    <input type="number" id="modelPrice" min="0" step="0.01" required
                                                                           placeholder="Contoh: 75000000"
                                                                           class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm border px-3 py-2">
                                                                </div>
                                                                <div class="w-1/3">
                                                                    <label for="modelStock" class="block text-sm font-medium text-gray-700">Stok <span
                                                                        class="text-red-500">*</span></label>
                                                                        <input type="number" id="modelStock" min="0" required placeholder="0"
                                                                               class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm border px-3 py-2">
                                                                    </div>
                                                                </div>

                                                                <div class="mb-2 flex items-center">
                                                                    <input type="checkbox" id="modelIsActive"
                                                                           class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" checked>
                                                                    <label for="modelIsActive" class="ml-2 block text-sm text-gray-900">Status Aktif</label>
                                                                </div>
                                                            </form>
                                                        </div>
                                                        <div class="bg-gray-50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6">
                                                            <button type="button" onclick="modelController.save()"
                                                                    class="inline-flex w-full justify-center rounded-md border border-transparent bg-indigo-600 px-4 py-2 text-base font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 sm:ml-3 sm:w-auto sm:text-sm">Simpan</button>
                                                            <button type="button" onclick="modelController.hideModal()"
                                                                    class="mt-3 inline-flex w-full justify-center rounded-md border border-gray-300 bg-white px-4 py-2 text-base font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm">Batal</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        @section Scripts {
                                            <script src="~/js/model.js"></script>
                                        }